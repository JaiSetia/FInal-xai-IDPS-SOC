LAB_VICTIM_PASSWORD=change-me-lab-only
# Dashboard login for the lab SOC (user "admin"), at least 12 characters.
LAB_SOC_ADMIN_PASSWORD=change-me-lab-only

# --- Integrations (all optional; leave blank to keep them off). Placeholders only: put real
# values in lab/.env, which is git-ignored. See docs/soc.md "Integrations" and lab/README.md.
# The lab SOC can't open outbound connections, so try them against receivers on its own
# loopback (lab/soc/listen.py) with the two ALLOW flags below. DEV/LAB ONLY: never in production.
LAB_NOTIFY_ALLOW_PRIVATE=
LAB_NOTIFY_ALLOW_HTTP=
LAB_NOTIFY_MIN_SEVERITY=
LAB_SOC_PUBLIC_URL=
LAB_WEBHOOK_URL=
LAB_WEBHOOK_SECRET=
LAB_SLACK_WEBHOOK_URL=
LAB_SMTP_HOST=
LAB_SMTP_PORT=
LAB_SMTP_SECURITY=
LAB_SMTP_USERNAME=
LAB_SMTP_PASSWORD=
LAB_SMTP_FROM=
LAB_SMTP_TO=
LAB_SYSLOG_HOST=
LAB_SYSLOG_PORT=
LAB_SYSLOG_PROTOCOL=
LAB_SYSLOG_CA_FILE=
LAB_ABUSEIPDB_KEY=
# The lab SOC can't reach the internet. To let it reach HTTPS services (AbuseIPDB, Slack, an
# HTTPS webhook), list their hosts, e.g. api.abuseipdb.com,hooks.slack.com. HTTPS only: SMTP and
# syslog stay blocked. Risks: lab/README.md, "How the lab is isolated".
LAB_SOC_EGRESS_HOSTS=

# --- SOC database (roadmap step 10). postgres (default: the soc-db container, which makes its
# own password) or sqlite. Moving to postgres copies an existing soc.db across once, on start.
LAB_SOC_DATABASE=
# Data retention in days, 0 = keep forever; blank keeps the SOC's defaults (docs/soc.md).
LAB_ALERT_RETENTION_DAYS=
LAB_AUDIT_RETENTION_DAYS=
